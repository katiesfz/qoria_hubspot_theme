  <body leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;margin: 0;padding: 0;height: 100% !important;width: 100% !important;">

    <div style="background-color: #ffffff;">
      <table align="center" height="100%" width="100%" cellpadding="0" cellspacing="0" border="0" id="backgroundTable" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;font-family: Quicksand, Verdana, sans-serif;margin: 0;padding: 0;border-collapse: collapse !important;height: 100% !important;width: 100% !important;">
        <tr>
          <td valign="top" align="center" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;background-repeat: no-repeat;background-size: 100% auto;background-position: top center;margin: 0;padding: 0;height: 100% !important;width: 100% !important;">
            <table border="0" cellpadding="0" cellspacing="0" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;width: 700px;-webkit-font-smoothing: antialiased;border-collapse: collapse !important;">
              <tr>
                <td align="right" valign="top" colspan="12" width="100.0%" class="column" style="text-align: right;font-family: Quicksand, Verdana, sans-serif;font-size: 16px;line-height: 1.5em;color: #000000;padding: 32px;-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;">
				<#if transaction.subsidiary.custrecord_q_branding?lower_case == "historical">
					<img style="width: 100%;max-width: ${transaction.subsidiary.custrecord_q_colour_logo_width}px;height: auto;display: inline-block;margin-bottom: 0px; vertical-align: bottom;-ms-interpolation-mode: bicubic;" src="${transaction.subsidiary.custrecord_q_coloured_logo}" />
				<#else />
					<@filecabinet nstype="image" alt="" style="width: 100%;max-width: 118px;height: auto;display: inline-block;margin-bottom: 0px; vertical-align: bottom;-ms-interpolation-mode: bicubic;" class="header-logo" src="https://6607213.app.netsuite.com/core/media/media.nl?id=2262785&c=6607213&h=viSda0ur7yGt0zygqPlv0WVi0O6ZMLgl1no0hULao39JaQpC&fcts=20230905205409&whence=" />
				</#if>                </td>
              </tr>
              <tr>
                <td align="left" valign="top" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;padding: 10px 20px;">
                  {{messageContent}}
                </td>
              </tr>
            </table>
            <!-- End Template Container -->
          </td>
        </tr>
        <tr>
          <td align="center" valign="top" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;padding: 10px 20px;">
            <div style="background-color:#58b78e; width: 100%; max-width: 1000px;">
              <!--[if gte mso 9]>
              <v:background xmlns:v="urn:schemas-microsoft-com:vml" fill="t">
              <v:fill type="tile" src="https://qoria.com/hubfs/images/Email%20Assets/qoria-footer-bg.png" color="#58b78e"/>
              </v:background>
              <![endif]-->
              <table height="100%" width="100%" cellpadding="0" cellspacing="0" border="0" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;border-collapse: collapse !important;">
                <tr>
                  <td valign="top" align="center" background="https://qoria.com/hubfs/images/Email%20Assets/qoria-footer-bg.png" style="background-size: cover;background-position: center right;padding: 32px 0;-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;">
            
                    <div style="color: #fff; max-width: 700px; text-align: center;">
<#if transaction.subsidiary.custrecord_q_branding?lower_case == "historical">
					<img style="width: 100%;max-width: ${transaction.subsidiary.custrecord_q_white_logo_width}px;height: auto;display: inline-block;margin-bottom: 16px;color: #ffffff;vertical-align: bottom;-ms-interpolation-mode: bicubic;" src="${transaction.subsidiary.custrecord_q_white_logo}" />
				<#else />
					<@filecabinet nstype="image" alt="" style="width: 100%;max-width: 118px;height: auto;display: inline-block;margin-bottom: 16px; vertical-align: bottom;-ms-interpolation-mode: bicubic;" class="header-logo" src="https://6607213.app.netsuite.com/core/media/media.nl?id=2262776&c=6607213&h=REaSL8JSd33cCBPOCmhSaoE1fBWsDGZmtwbkqcryyWHvSg_j&fcts=20230905204832&whence=" />
				</#if>                      <h4 style="text-align: center;color: #ffffff;margin-bottom: 5px;display: block;font-family: Quicksand, Verdana, sans-serif;font-weight: 300;line-height: 125%;margin-top: 0;margin-right: 0;margin-left: 0;font-size: 1.2rem;">
                        Create cyber-safe communities where students thrive.
                      </h4>
                      <p class="small" style="color: #ffffff;text-align: center;margin-top: 0;font-weight: light;line-height: 125%;margin-bottom: 10px;font-size: 0.9rem;-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;">
                        Support student wellbeing. Powerful insights and analytics. Engage your school community.
                      </p>
                    </div>
                  </td>
                </tr>
              </table>
            </div>
          </td>
        </tr>
        <tr>
          <td align="center" style="-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;mso-table-lspace: 0pt;mso-table-rspace: 0pt;">
            <p align="center" style="margin-bottom: 5px;line-height: 125%;font-size: 0.8rem;-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;">${transaction.subsidiary.legalname}</p>

            <p align="center" style="line-height: 125%;margin-bottom: 10px;font-size: 0.8rem;-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;">${transaction.subsidiary.addr1}, ${transaction.subsidiary.addr2}<br/>
                              ${transaction.subsidiary.city} ${transaction.subsidiary.state} <span style="color: #58b78e">|</span> ${transaction.subsidiary.zip} <span  style="color: #58b78e">|</span> ${transaction.subsidiary.country}</p>
          </td>
        </tr>
      </table>
    </div>
