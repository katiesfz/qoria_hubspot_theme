{
    "liveSassCompile.settings.excludeList": [
        "/.vscode/**",
        "/**/node_modules/**"
    ],
    "liveSassCompile.settings.forceBaseDirectory": "/sass",
    "liveSassCompile.settings.formats": [

        {
            "format": "expanded",
            "extensionName": ".css",
            "savePath": "/css",
            "savePathReplacementPairs": null
        },
        {
            "format": "compressed",
            "extensionName": ".min.css",
            "savePath": "/css",
            "savePathReplacementPairs": null
        }
    ],
    "liveSassCompile.settings.includeItems": [
        "/scss/qoria-theme.scss",
        "/scss/smart-recruiters-styles.scss",
        "/scss/easy-webinar-styles.scss",
        "/scss/qoria-theme-partner.scss"
    ],
    "liveSassCompile.settings.generateMap": false,
    "files.associations": {
        "*.html": "html-hubl",
        "*.css": "css-hubl"
    },
    "liveSassCompile.settings.autoprefix": [
    ],
    "search.exclude": {
        "**/node_modules": false
    },
    "html.format.indentHandlebars": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "liveServer.settings.root": "",
    "liveSassCompile.settings.rootIsWorkspace": true,
    "prettier.tabWidth": 4
  
}