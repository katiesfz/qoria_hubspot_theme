name: Deploy HubSpot Theme - Live

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        account:
          - name: LW-ANZ
            id: 123456
          - name: LW-US
            id: 654321

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Install Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '22.19.0'

      - name: Install HubSpot CLI
        run: npm install -g @hubspot/cli

      - name: Authenticate and Upload Theme
        run: |
          if [ "${{ matrix.account.name }}" = "LW-ANZ" ]; then
            echo "${{ secrets.HUBSPOT_PAK_ANZ }}" > token.txt
          elif [ "${{ matrix.account.name }}" = "LW-US" ]; then
            echo "${{ secrets.HUBSPOT_PAK_US }}" > token.txt
          fi
          hs auth --pak "$(cat token.txt)" --account="${{ matrix.account.name }}"
          hs upload qoria-theme q-theme --account="${{ matrix.account.name }}"




      - name: Install Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '22.19.0'

      - name: Install HubSpot CLI
        run: npm install -g @hubspot/cli

        
      - name: Make deploy.sh executable
        run: chmod +x deploy.sh

      - name: Authenticate and Upload Theme
        run: |
          if [ "${{ matrix.account.name }}" = "LW-ANZ" ]; then
            ./deploy.sh "${{ secrets.HUBSPOT_PAK_ANZ }}" "{{ matrix.account.name }}"
          elif [ "${{ matrix.account.name }}" = "LW-US" ]; then
            ./deploy.sh "${{ secrets.HUBSPOT_PAK_US }}" "{{ matrix.account.name }}"
          fi
          hs auth --pak "$(cat token.txt)" --account="${{ matrix.account.name }}"
          hs upload qoria-theme q-theme --account="${{ matrix.account.name }}"
