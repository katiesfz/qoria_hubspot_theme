name: Deploy HubSpot Theme - Live

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: HubSpot Deploy Action ANZ
        uses: HubSpot/hubspot-cms-deploy-action@v2.0.1
        with:
          src_dir: qoria-theme
          dest_dir: q-theme
          account_id: ${{ secrets.HUBSPOT_ACCOUNT_ID_ANZ }}
          personal_access_key: ${{ secrets.HUBSPOT_PAK_ANZ }}